{
  "name": "morpheus-ast",
  "version": "0.1.0",
  "private": true,
  "description": "MORPHEUS-AST — Headless 3D AST Compiler Engine powering InfraShield 3D and NECRO-COMPILER (Kiroween 2026)",
  "scripts": {
    "lint:boundaries": "pnpm --filter morpheus-ast-core exec ts-node ../../scripts/check-boundaries.ts",
    "test:pbt": "pnpm --filter morpheus-ast-core run test:pbt",
    "test": "pnpm --filter morpheus-ast-core run test",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "clean": "pnpm --recursive run clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "5.4.5"
  }
}
