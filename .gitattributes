# Normalize line endings to LF in the repository for all text files.
# Checked-out files use the OS default (CRLF on Windows, LF on Unix).
* text=auto

# Force LF for files that must stay LF everywhere
*.ts   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.sh   text eol=lf

# Binaries — never touch line endings
*.exe  binary
*.png  binary
*.jpg  binary
*.wasm binary
